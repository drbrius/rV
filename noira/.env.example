# NOIRA — Server-Konfiguration
#
# Für die Entwicklung genügt es, diese Datei zu ignorieren: Ohne
# Werte fährt der Server mit abgeleiteten Entwicklungsschlüsseln
# hoch. Im Betrieb (NODE_ENV=production) verweigert er den Start,
# solange PASSWORD_PEPPER, IP_HASH_SALT und DOCUMENT_KEY fehlen.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Woher die Oberfläche kommt — bestimmt Rücksprungadressen der Zahlung.
PUBLIC_ORIGIN=http://localhost:3000

# Ablage. ":memory:" für Tests.
DATABASE_PATH=var/noira.db
STORAGE_DIR=var/storage

# 32 Byte, hex oder base64. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_KEY=

# Pfeffer für Passwort-Hashes und Salz für IP-Hashes. Beides liegt im
# Prozess, nicht in der Datenbank: Wer nur die Datenbank erbeutet,
# hat damit weder knackbare Hashes noch zuordenbare Adressen.
PASSWORD_PEPPER=
IP_HASH_SALT=

# mock | datatrans | btcpay
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
